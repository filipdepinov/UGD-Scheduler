<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UGDScheduler" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/ugd_red</item>
        <item name="colorPrimaryVariant">@color/ugd_dark_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ugd_red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/ugd_dark_red</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="actionBarStyle">@style/UGDActionBar</item>
    </style>

    <style name="UGDActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/ugd_red</item>
        <item name="titleTextStyle">@style/UGDActionBarTitle</item>
    </style>

    <style name="UGDActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.UGDScheduler.Splash" parent="Theme.UGDScheduler">
        <item name="android:windowBackground">@color/ugd_red</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="UGDButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/ugd_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="UGDButtonOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/ugd_red</item>
        <item name="android:textColor">@color/ugd_red</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
